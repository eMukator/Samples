<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        xmlns:behaviors="clr-namespace:WpfApp.Behaviors"
        mc:Ignorable="d"
        Title="Sample app" Height="450" Width="800">

  <Window.DataContext>
    <local:MainViewModel/>
  </Window.DataContext>

  <DockPanel>
      <Menu x:Name="menu" DockPanel.Dock="Top">
        <MenuItem Header="_File">
          <MenuItem Header="_Dummy" Command="{Binding LoadDefaultDataCommand}" />
          <Separator />
          <MenuItem Header="_Load" Command="{Binding LoadFromJsonCommand}" />
          <MenuItem Header="_Save" Command="{Binding SaveToJsonCommand}" />
          <Separator />
          <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
        </MenuItem>
        <MenuItem Header="_Help" Command="{Binding HelpCommand}" />
      </Menu>
      
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
         
        <ListBox x:Name="listBox" d:ItemsSource="{d:SampleData ItemCount=7}" ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 PreviewMouseDoubleClick="ListView_MouseDoubleClick"
                 behaviors:DragDropBehavior.ReorderCommand="{Binding ReorderCommand}">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Grid>
                    <Border x:Name="Above" Height="2" Background="#4A90E2" VerticalAlignment="Top" Visibility="Collapsed"/>
                    <Border x:Name="Below" Height="2" Background="#4A90E2" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                    <Border x:Name="Bd" Padding="4" Background="Transparent">
                      <ContentPresenter Margin="0"/>
                    </Border>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="behaviors:DragDropBehavior.IsDropAbove" Value="True">
                      <Setter TargetName="Above" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="behaviors:DragDropBehavior.IsDropBelow" Value="True">
                      <Setter TargetName="Below" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#CDE5FF"/>
                      <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>

        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Background="Transparent" Width="Auto" Grid.Row="1" Orientation="Horizontal" Margin="5">
              <TextBlock Text="{Binding Id}" Margin="0,0,5,0" />
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                <TextBlock Text="{Binding Description}" Foreground="Gray"/>
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10">
          <Button Padding="10,2" Margin="0,0,10,0" Command="{Binding AddCommand}" CommandParameter="{Binding SelectedItem}">Add</Button>
          <Button Padding="10,2" Margin="0,0,10,0" Command="{Binding EditCommand}" CommandParameter="{Binding SelectedItem}">Edit</Button>
          <Button Padding="10,2" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItem}">Remove</Button>
        </StackPanel>
      </Grid>

    </DockPanel>
</Window>
